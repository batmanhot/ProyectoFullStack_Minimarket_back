NODE_ENV=development
APP_MODE=development
PORT=3001
# Development binds to 127.0.0.1 by default. Set HOST=0.0.0.0 only with
# non-default strong credentials; production uses 0.0.0.0 automatically.
# HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
SUPERADMIN_USER=superadmin
SUPERADMIN_PASS=replace-with-a-long-random-password

# Obligatoria solo para los E2E. Debe ser una base PostgreSQL aislada cuyo
# nombre incluya "e2e"; nunca use la URL de desarrollo o producción.
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/minimarket_e2e?schema=public

# Production: use HTTPS origins only, separated by commas.
# CORS_ORIGINS=https://app.example.com,https://www.example.com
